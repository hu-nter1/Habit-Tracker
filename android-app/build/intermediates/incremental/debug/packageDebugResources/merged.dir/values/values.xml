    <string name="app_name">Day by Day</string>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.StudyTracker.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.StudyTracker.Button.Outlined</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:statusBarColor">@color/primary_variant</item>
        <item name="android:navigationBarColor">@color/primary_variant</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="TextAppearance.StudyTracker.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.StudyTracker.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.StudyTracker.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>